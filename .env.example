# Copie para .env e preencha. O .env esta no .gitignore.

# mongo = le o Atlas de verdade (exige MONGO_URI + MONGO_PASSWORD)
# seed  = gera dados sinteticos no mesmo schema, sem precisar de banco
DATA_SOURCE=mongo

# Cole a string do painel do Atlas como ela vem, com <db_password> literal.
MONGO_URI=mongodb+srv://<usuario>:<db_password>@<cluster>/?retryWrites=true&w=majority
# A senha entra aqui separada. Caractere especial e escapado pelo codigo.
MONGO_PASSWORD=
MONGO_DB=PrincipalDB

# Semente do gerador sintetico, para todos verem os mesmos numeros
SEED=42
